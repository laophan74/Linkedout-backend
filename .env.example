# Example environment variables
# Copy this to .env and fill in your actual values

# MongoDB Connection
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/linkedout?retryWrites=true&w=majority

# JWT Secret (minimum 20 characters, MUST change in production!)
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars

# Server Configuration
PORT=3030
NODE_ENV=development

# CORS Origins (comma-separated list of allowed frontend URLs)
# Development: http://localhost:3000,http://localhost:3001
# Production: https://yourdomain.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://linkedout-frontend.vercel.app

# Logging Level
LOG_LEVEL=info

# Cloudinary Configuration (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_password

# Google Cloud Vision (Optional - for image analysis)
GOOGLE_CLOUD_API_KEY=your_api_key
